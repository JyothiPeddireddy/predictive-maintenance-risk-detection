# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore and must NEVER be committed.
PM_DB_HOST=localhost
PM_DB_PORT=5432
PM_DB_NAME=predictive_maintenance
PM_DB_USER=pm_user
PM_DB_PASSWORD=YOUR_NEW_PASSWORD

# Tests use a SEPARATE database whose name must end with "_test"
# (the test suite drops and recreates its tables).
PM_TEST_DB_NAME=predictive_maintenance_test
